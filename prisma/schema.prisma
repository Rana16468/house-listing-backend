generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum RentalCategory {
  house_flat
  sublet_room
}

enum TenantType {
  family
  bachelor_male
  bachelor_female
  office
}

enum ParkingType {
  none
  car
  bike
  car_and_bike
  garage
  street
  not_available
}

enum GasType {
  line
  cylinder
}

enum ElectricityType {
  prepaid
  postpaid
}

// ------------------------------------------------------
// Composite Types (MongoDB Embedded Sub-documents)
// ------------------------------------------------------

type Location {
  division String
  district String
  thana    String
  area     String
}

type UtilityBreakdown {
  baseRent        Float           @default(0.00)
  electricity     Float           @default(0.00)
  electricityType ElectricityType
  gas             Float           @default(0.00)
  gasType         GasType
  serviceCharge   Float           @default(0.00)
  water           Float           @default(0.00)
}

type ContactInfo {
  phone          String
  whatsapp       Boolean @default(false)
  telegram       Boolean @default(false)
  imo            Boolean @default(false)
  teams          Boolean @default(false)
  telegramHandle String?
  teamsLink      String?
}

model Post {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  category        RentalCategory
  tenantType      TenantType
  parking         ParkingType      @default(none)
  address         String?
  liveLocationUrl String?
  images          String[]
  availableFrom   String
  pin             String
  source          String           @default("user")
  deviceId        String
  // Embedded Structured Fields
  location        Location
  utilities       UtilityBreakdown
  contact         ContactInfo
  os              String?
  browser         String?
  device          String?
  ipAddress       String?
  isDelete        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category, tenantType, os, device, browser, deviceId])
  @@index([location.division, location.district, location.thana, contact.phone, utilities.baseRent, availableFrom])
  @@index([createdAt(sort: Desc)])
  @@index([ipAddress])
  @@index([pin])
  @@map("posts")
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  BLOCKED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String?
  email     String?
  photo     String?
  status    Status   @default(ACTIVE)
  role      Role     @default(USER)
  os        String?
  browser   String?
  device    String?
  ipAddress String?
  isOnline  Boolean  @default(false)
  isVerify  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, email, status, os, browser, device, isDeleted, isVerify, createdAt])
  @@index([role])
  @@index([ipAddress])
  @@index([isDeleted, role])
  @@map("users")
}
